---
import { formatDate } from "../utils";

interface Props {
  title: string;
  pubDate: Date;
}

const { title, pubDate } = Astro.props as Props;
---

<main class="container">
  <nav aria-label="breadcrumb">
    <ul>
      <li><a href="/">{"< Back"}</a></li>
    </ul>
  </nav>
  <h2>{title}</h2>
  <small>
    {formatDate(pubDate)}
  </small>
  <hr />
  <section>
    <slot />
  </section>
</main>
