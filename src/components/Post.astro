---
import { formatDate } from "../utils";
import "../styles/content.css";

interface Props {
  title: string;
  pubDate: Date;
}

const { title, pubDate } = Astro.props as Props;
---

<main class="post">
  <a class="post-back-link" href="/">&larr; All posts</a>
  <h1 class="post-heading">{title}</h1>
  <time class="post-meta" datetime={pubDate.toISOString()}>
    {formatDate(pubDate)}
  </time>
  <div class="post-content">
    <slot />
  </div>
</main>
