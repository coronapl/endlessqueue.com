---
import type { CollectionEntry } from "astro:content";
import { formatDate, getExcerpt } from "../utils";
import PostTags from "./PostTags.astro";

interface Props {
  post: CollectionEntry<"posts"> | CollectionEntry<"tils">;
}

const { post } = Astro.props as Props;
const { id, body, data } = post;
const { title, pubDate } = data;

const excerpt =
  data.type === "post" ? data.description : getExcerpt(body ?? "");
const link =
  data.type === "post"
    ? {
        href: `posts/${id}`,
        ariaLabel: `Read Post: ${title}`,
      }
    : {
        href: `tils/${id}`,
        ariaLabel: `Read TIL: ${title}`,
      };
---

<article class="post-item">
  <a href={link.href} aria-label={link.ariaLabel}>
    <time class="post-item-date" datetime={pubDate.toISOString()}>
      {formatDate(pubDate)}
    </time>
    <h2 class="post-item-title">{title}</h2>
    <p class="post-item-excerpt">{excerpt}</p>
    {data.type === "til" && <PostTags tags={data.tags} />}
  </a>
</article>
